    { "name": "settings_label_gamma", "value": "Gamma 校正" },
    { "name": "settings_desc_gamma", "value": "将 sRGB 伽马曲线应用于亮度/对比度/饱和度调整前，避免色彩偏移。建议保持开启。" },
    { "name": "settings_label_dither", "value": "RGB565 抖动" },
